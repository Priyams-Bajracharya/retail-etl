        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n  subgraph SRC[\&quot;LANDING: data/landing, 5 files per day\&quot;]\n    F1[\&quot;item_master\&quot;]\n    F2[\&quot;store_master\&quot;]\n    F3[\&quot;customer_master\&quot;]\n    F4[\&quot;pos_sales\&quot;]\n    F5[\&quot;inventory_snapshot\&quot;]\n  end\n\n  W{{\&quot;wait_for_files&lt;br/&gt;sensor, timeout from Variable&lt;br/&gt;FAIL\&quot;}}\n  L[\&quot;list_files\&quot;]\n\n  subgraph BRZ[\&quot;BRONZE: raw, as landed (Snowflake)\&quot;]\n    LB[\&quot;load_bronze&lt;br/&gt;one mapped task per file&lt;br/&gt;PUT, COPY INTO\&quot;]\n    B1[\&quot;BRZ_ITEM_MASTER\&quot;]\n    B2[\&quot;BRZ_STORE_MASTER\&quot;]\n    B3[\&quot;BRZ_CUSTOMER_MASTER\&quot;]\n    B4[\&quot;BRZ_POS_SALES\&quot;]\n    B5[\&quot;BRZ_INVENTORY_SNAPSHOT\&quot;]\n  end\n\n  G1{{\&quot;Bronze rows = file rows&lt;br/&gt;FAIL\&quot;}}\n\n  subgraph SLV[\&quot;SILVER: clean and conformed\&quot;]\n    S1[\&quot;SLV_ITEM\&quot;]\n    S2[\&quot;SLV_LOCATION\&quot;]\n    S3[\&quot;SLV_CUSTOMER\&quot;]\n    S4[\&quot;SLV_INVENTORY_POSITION\&quot;]\n    S5[\&quot;SLV_SALES_LINE\&quot;]\n    REJ[\&quot;REJ_ROW&lt;br/&gt;quarantine with reason code\&quot;]\n  end\n\n  Q{{\&quot;Sales rules&lt;br/&gt;NULL_ITEM_ID, BAD_VALUE, NEGATIVE_QTY,&lt;br/&gt;ITEM_NOT_IN_MASTER, DUPLICATE_LINE&lt;br/&gt;QUARANTINE\&quot;}}\n  G2{{\&quot;Bronze sales = Silver + rejected&lt;br/&gt;FAIL\&quot;}}\n\n  subgraph GLD[\&quot;GOLD: the 2.1 model\&quot;]\n    subgraph DIMS[\&quot;Dimensions, parents before children\&quot;]\n      D1[\&quot;Calendar&lt;br/&gt;DIM_YEAR, MONTH, WEEK, DAY\&quot;]\n      D2[\&quot;DIM_CATG, DIM_SUBCATG&lt;br/&gt;DIM_ITEM&lt;br/&gt;SCD2 brand, subcategory&lt;br/&gt;SCD1 item name\&quot;]\n      D3[\&quot;DIM_REGN, DIM_DISTRICT&lt;br/&gt;DIM_LOCN&lt;br/&gt;SCD2 district&lt;br/&gt;SCD1 store name\&quot;]\n      D4[\&quot;DIM_CUSTOMER&lt;br/&gt;Unknown row -1\&quot;]\n    end\n    subgraph FCTS[\&quot;Facts\&quot;]\n      FS[\&quot;FCT_SALES&lt;br/&gt;delete and reload by DAY_KY\&quot;]\n      FI[\&quot;FCT_INVENTORY&lt;br/&gt;rows closed, never deleted\&quot;]\n    end\n  end\n\n  R{{\&quot;reconcile&lt;br/&gt;Silver vs Gold rows and amounts&lt;br/&gt;one current row per item and store&lt;br/&gt;FAIL the DAG\&quot;}}\n\n  CFG[\&quot;Airflow Variables and Connection snowflake_retail&lt;br/&gt;no hard-coded credentials, paths or table names\&quot;]\n\n  F1 --&gt; W\n  F2 --&gt; W\n  F3 --&gt; W\n  F4 --&gt; W\n  F5 --&gt; W\n  W --&gt; L --&gt; LB\n  LB --&gt; B1\n  LB --&gt; B2\n  LB --&gt; B3\n  LB --&gt; B4\n  LB --&gt; B5\n  B1 --&gt; G1\n  B2 --&gt; G1\n  B3 --&gt; G1\n  B4 --&gt; G1\n  B5 --&gt; G1\n  G1 --&gt; S1\n  G1 --&gt; S2\n  G1 --&gt; S3\n  G1 --&gt; S4\n  G1 --&gt; Q\n  Q --&gt;|clean rows| S5\n  Q -.-&gt;|failed rows| REJ\n  S5 --&gt; G2\n  REJ --&gt; G2\n  W --&gt; D1\n  S1 --&gt; D2\n  S2 --&gt; D3\n  S3 --&gt; D4\n  D1 --&gt; FS\n  D2 --&gt; FS\n  D3 --&gt; FS\n  D4 --&gt; FS\n  S5 --&gt; FS\n  S4 --&gt; FI\n  D2 --&gt; FI\n  D3 --&gt; FI\n  FS --&gt; R\n  FI --&gt; R\n  CFG -.-&gt; W\n  CFG -.-&gt; LB\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ihdnahb92mztIpjhSWVe-1">
